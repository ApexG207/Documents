{
  "name": "matiq-training-aid",
  "version": "3.0.0-beta.1",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "bash scripts/build-verified.sh",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && npm run test:unit && npm run test:artifact",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "verify": "npm run release:preflight && npm run format:check && npm run lint && npm run typecheck && npm test",
    "release:preflight": "node scripts/release-preflight.mjs",
    "release:manifest": "node scripts/release-manifest.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prebuild": "node scripts/sync-version.mjs",
    "test:unit": "node --experimental-strip-types --import ./tests/harness/register.mjs --test tests/guardian-consent.test.mjs tests/migrations.test.mjs tests/readiness.test.mjs tests/revenue-pool.test.mjs tests/tenancy.test.mjs",
    "test:artifact": "node --test tests-artifact/rendered-html.test.mjs"
  },
  "dependencies": {
    "@stripe/connect-js": "^3.4.6",
    "@stripe/react-connect-js": "^3.4.4",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.34.0",
    "next": "16.3.2",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "prettier": "3.4.2",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "MatIQ Jiu-Jitsu Intelligence Training Aid"
}
